<Window x:Class="RestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RestaurantApp.Views"
        xmlns:local="clr-namespace:RestaurantApp"
        mc:Ignorable="d"
        Title="Restaurant App" Height="600" Width="900"
        x:Name="window"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Left menu panel width -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- User info panel -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- User Info Panel - spans across the entire top -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#1E1E1E">
            <Button x:Name="btnLogin" Content="Login" Click="LoginButton_Click" 
                    DockPanel.Dock="Right" Margin="5" Padding="10,5" 
                    Background="#2D2D30" Foreground="White" BorderBrush="#444"/>
            <Button x:Name="btnLogout" Content="Logout" Click="LogoutButton_Click" 
                    DockPanel.Dock="Right" Margin="5" Padding="10,5" Visibility="Collapsed" 
                    Background="#2D2D30" Foreground="White" BorderBrush="#444"/>
            <Button x:Name="btnCart" DockPanel.Dock="Right" Click="CartButton_Click" 
                    Margin="5" Padding="10,5" Background="#2D2D30" Foreground="White" BorderBrush="#444">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛒" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Cart" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#4CAF50" CornerRadius="10" Margin="5,0,0,0" 
                            Visibility="{Binding ShoppingCartItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="{Binding ShoppingCartItemCount}" Foreground="White" Margin="5,0" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Button>
            <TextBlock x:Name="userInfoText" Foreground="White" VerticalAlignment="Center" 
                       Margin="10,0,0,0" FontSize="14"/>
        </DockPanel>

        <!-- Vertical Navigation Panel - left side -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#252526" Orientation="Vertical">
            <Button Content="Menu" Margin="10" Padding="10,8" Click="MenuButton_Click"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                    HorizontalAlignment="Stretch"/>
            <Button Content="Search" Margin="10" Padding="10,8" Click="SearchButton_Click"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                    HorizontalAlignment="Stretch"/>
            <Button x:Name="btnOrders" Content="My Orders" Margin="10" Padding="10,8" 
                    Click="OrdersButton_Click" Visibility="Collapsed"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                    HorizontalAlignment="Stretch"/>

            <!-- Admin Panel - now vertical -->
            <Separator Margin="10" Background="#444" Visibility="{Binding ElementName=adminPanel, Path=Visibility}"/>
            <StackPanel x:Name="adminPanel" Orientation="Vertical" Visibility="Collapsed">
                <TextBlock Text="ADMIN" Foreground="#999" Margin="10,0,0,5" FontSize="12"/>
                <Button Content="Categories" Margin="10,5" Padding="10,8" Click="CategoriesButton_Click"
                        Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Products" Margin="10,5" Padding="10,8" Click="ProductsButton_Click"
                        Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                        HorizontalAlignment="Stretch"/>
                <Button Content="All Orders" Margin="10,5" Padding="10,8" Click="AllOrdersButton_Click"
                        Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Stock Alert" Margin="10,5" Padding="10,8" Click="StockAlertButton_Click"
                        Background="#3C3C3C" Foreground="White" BorderBrush="#444"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content - to the right of the menu -->
        <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainContent" Background="#1E1E1E"/>
    </Grid>
</Window>