<Window x:Class="RestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RestaurantApp.Views"
        xmlns:local="clr-namespace:RestaurantApp"
        mc:Ignorable="d"
        Title="Restaurant App" Height="900" Width="1600"
        x:Name="window"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#161B22">
            <TextBlock x:Name="userInfoText" Foreground="#C9D1D9" VerticalAlignment="Center" 
                       FontSize="14" Margin="10,0,0,0"/>

            <Button x:Name="btnCart" DockPanel.Dock="Right" Click="CartButton_Click" 
                    Margin="5,0" Background="#21262D" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛒" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Cart" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#238636" Margin="5,0,0,0"
                            Visibility="{Binding ShoppingCartItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="{Binding ShoppingCartItemCount}" Foreground="White" Margin="5,0" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Button>

            <Button x:Name="btnLogout" Content="Logout" Click="LogoutButton_Click" 
                    DockPanel.Dock="Right" Margin="5,0" Background="#21262D" Foreground="White" Visibility="Collapsed"/>
            <Button x:Name="btnLogin" Content="Login" Click="LoginButton_Click" 
                    DockPanel.Dock="Right" Margin="5,0" Background="#21262D" Foreground="White"/>
        </DockPanel>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#161B22">
            <Button Content="Menu" Margin="10,10,10,5" Click="MenuButton_Click"
                    Background="#21262D" Foreground="White"/>
            <Button Content="Search" Margin="10,5" Click="SearchButton_Click"
                    Background="#21262D" Foreground="White"/>
            <Button x:Name="btnOrders" Content="My Orders" Margin="10,5" Click="OrdersButton_Click"
                    Background="#21262D" Foreground="White" Visibility="Collapsed"/>

            <!-- Admin Section -->
            <Separator Margin="10,15,10,5" Background="#30363D" Visibility="{Binding ElementName=adminPanel, Path=Visibility}"/>
            <StackPanel x:Name="adminPanel" Visibility="Collapsed">
                <TextBlock Text="ADMIN" Foreground="#8B949E" Margin="10,5,0,5" FontSize="12" FontWeight="Bold"/>
                <Button Content="Categories" Margin="10,5" Click="CategoriesButton_Click"
                        Background="#21262D" Foreground="White"/>
                <Button Content="Products" Margin="10,5" Click="ProductsButton_Click"
                        Background="#21262D" Foreground="White"/>
                <Button Content="All Orders" Margin="10,5" Click="AllOrdersButton_Click"
                        Background="#21262D" Foreground="White"/>
                <Button Content="Stock Alert" Margin="10,5" Click="StockAlertButton_Click"
                        Background="#21262D" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainContent" Background="#0D1117"/>
    </Grid>
</Window>
