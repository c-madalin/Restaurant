<UserControl x:Class="RestaurantApp.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Controls -->
        <Border Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10" Background="#1E1E1E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="5" Margin="0,0,10,0" 
                         VerticalContentAlignment="Center"
                         Background="#333" Foreground="White" BorderBrush="#555"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <RadioButton Content="Search by Name" IsChecked="{Binding SearchForAllergen, Converter={StaticResource InverseBooleanConverter}}" 
                                 VerticalContentAlignment="Center" Margin="0,0,5,0"
                                 Foreground="White"/>
                    <RadioButton Content="Search by Allergen" IsChecked="{Binding SearchForAllergen}" 
                                 VerticalContentAlignment="Center"
                                 Foreground="White"/>
                </StackPanel>

                <CheckBox Grid.Column="2" Content="Invert Search (NOT)" IsChecked="{Binding InvertSearch}" 
                          VerticalContentAlignment="Center" Margin="0,0,10,0"
                          Foreground="White"/>

                <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" 
                        Padding="15,5" Background="#4CAF50" Foreground="White" BorderBrush="#388E3C"/>
            </Grid>
        </Border>

        <!-- Message -->
        <TextBlock Grid.Row="2" Text="{Binding Message}" 
                   Foreground="#90EE90" Margin="10"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Search Results -->
        <ListView Grid.Row="1" ItemsSource="{Binding SearchResults}" Margin="10" Background="#1E1E1E" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding CategoryName}" Width="100"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat='{}{0:C}'}" Width="70"/>
                    <GridViewColumn Header="Portion" DisplayMemberBinding="{Binding PortionSize, StringFormat='{}{0}g'}" Width="70"/>
                    <GridViewColumn Header="Available" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAvailable}" IsEnabled="False" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Allergens" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Allergens}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#773333" Margin="2" Padding="2" CornerRadius="3">
                                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Actions" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Add to Cart" 
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#4CAF50" Foreground="White" BorderBrush="#388E3C"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
