<UserControl x:Class="RestaurantApp.Views.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Background="#161B22" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Background="#21262D" Foreground="White" Margin="10,5"/>
            <CheckBox DockPanel.Dock="Right" Content="Active Orders Only" IsChecked="{Binding ActiveOrdersOnly}" VerticalAlignment="Center" Margin="0,5,10,5" Foreground="White"/>
            <TextBlock Text="All Orders" FontSize="22" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center" Margin="10,5"/>
        </DockPanel>

        <!-- Orders List -->
        <ListView Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Margin="10"
                  Background="#161B22" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Order ID" DisplayMemberBinding="{Binding OrderId}" Width="70"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding OrderDate, StringFormat='{}{0:g}'}" Width="150"/>
                    <GridViewColumn Header="Customer" DisplayMemberBinding="{Binding CustomerName}" Width="150"/>
                    <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalAmount, StringFormat='{}{0:C}'}" Width="80"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                    <GridViewColumn Header="Actions" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Preparing" Margin="2" Background="#21262D" Foreground="White"
                                            Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Preparing"
                                            Visibility="{Binding Status, Converter={StaticResource OrderStatusToVisibilityConverter}, ConverterParameter=Registered}"/>
                                    <Button Content="Dispatched" Margin="2" Background="#21262D" Foreground="White"
                                            Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Dispatched"
                                            Visibility="{Binding Status, Converter={StaticResource OrderStatusToVisibilityConverter}, ConverterParameter=Preparing}"/>
                                    <Button Content="Delivered" Margin="2" Background="#21262D" Foreground="White"
                                            Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Delivered"
                                            Visibility="{Binding Status, Converter={StaticResource OrderStatusToVisibilityConverter}, ConverterParameter=Dispatched}"/>
                                    <Button Content="Cancel" Margin="2" Background="#B00020" Foreground="White"
                                            Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Cancelled"
                                            Visibility="{Binding Status, Converter={StaticResource OrderStatusToVisibilityConverter}, ConverterParameter=Active}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Order Details -->
        <Expander Grid.Row="2" Header="Order Details" Margin="10" IsExpanded="True" Background="#161B22" Foreground="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Message}" Foreground="#7CE38B" Margin="0,0,0,10"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer:" FontWeight="Bold" Margin="0,0,10,5" Foreground="White"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.CustomerName}" Margin="0,0,20,5" Foreground="White"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Phone:" FontWeight="Bold" Margin="0,0,10,5" Foreground="White"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedOrder.CustomerPhone}" Margin="0,0,0,5" Foreground="White"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Address:" FontWeight="Bold" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedOrder.DeliveryAddress}" TextWrapping="Wrap" Foreground="White"/>
                </Grid>

                <ListView Grid.Row="2" ItemsSource="{Binding SelectedOrder.OrderItems}" MaxHeight="200" Background="#161B22" Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Product" DisplayMemberBinding="{Binding ProductName}" Width="200"/>
                            <GridViewColumn Header="Unit Price" DisplayMemberBinding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                            <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="70"/>
                            <GridViewColumn Header="Total" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:C}'}" Foreground="White"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Expander>
    </Grid>
</UserControl>