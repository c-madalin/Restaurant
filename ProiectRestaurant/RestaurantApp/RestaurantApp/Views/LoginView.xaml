<UserControl x:Class="RestaurantApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#121212">
    <Grid>
        <Border Width="400" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" 
                CornerRadius="5" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Login" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="White"/>

                <TextBlock Text="Email:" Margin="0,10,0,5" Foreground="White"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="5" 
                         Background="#333" Foreground="White" BorderBrush="#555" BorderThickness="1"/>

                <TextBlock Text="Password:" Margin="0,10,0,5" Foreground="White"/>
                <PasswordBox x:Name="PasswordBox" Padding="5" PasswordChanged="PasswordBox_PasswordChanged" 
                             Background="#333" Foreground="White" BorderBrush="#555" BorderThickness="1"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" Margin="0,10,0,0" 
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="Login" Command="{Binding LoginCommand}" Margin="0,20,0,0" Padding="10,5" 
                        Background="#4CAF50" Foreground="White" BorderBrush="#388E3C" BorderThickness="1"/>

                <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Margin="0,20,0,5" Foreground="White"/>
                <Button Content="Register" Command="{Binding RegisterNavigationCommand}" 
                        HorizontalAlignment="Center" Padding="10,5" 
                        Background="#2196F3" Foreground="White" BorderBrush="#1769AA" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
