<UserControl x:Class="RestaurantApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Restaurant Menu" FontSize="24" FontWeight="SemiBold" Margin="10"
                   Foreground="White"/>

        <!-- Message display -->
        <TextBlock Grid.Row="2" Text="{Binding Message}" 
                   Foreground="#4CAF50" Margin="10"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Menu categories and products -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Name}" Margin="5" IsExpanded="True" 
                                  Background="#1E1E1E" Foreground="White" BorderBrush="#333" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#333" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5"
                                                Background="#1E1E1E">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Placeholder for image -->
                                                <Border Grid.Column="0" Width="80" Height="80" Background="#333" Margin="0,0,10,0" CornerRadius="3">
                                                    <TextBlock Text="Food" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                    <TextBlock Text="{Binding PortionSize, StringFormat='Portion: {0}g'}" Margin="0,5,0,0" Foreground="#CCCCCC"/>
                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Text="Allergens: " FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                                        <ItemsControl ItemsSource="{Binding Allergens}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" Margin="0,0,5,0" Foreground="#AAAAAA"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                                    <TextBlock Text="Not Available" Foreground="#FF6B6B" 
                                                               Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                    <Button Content="Add to Cart" 
                                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,10,0,0" Padding="10,5"
                                                            Background="#4CAF50" Foreground="White"
                                                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
